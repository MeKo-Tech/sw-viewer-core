{
  "name": "@meko-tech/sw-viewer-core",
  "version": "0.2.0",
  "private": true,
  "description": "Decodes embedded display meshes and thumbnails from SolidWorks parts and assemblies in the browser",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts",
    "./three": "./src/three/index.ts",
    "./react": "./src/react/index.ts"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "inspect": "node tools/inspect.ts",
    "demo": "node node_modules/vite/bin/vite.js demo",
    "build:demo": "node node_modules/vite/bin/vite.js build demo --outDir ../dist/demo --emptyOutDir",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "release": "node tools/release.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.160"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  }
}
